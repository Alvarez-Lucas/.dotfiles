    window-rule {
        geometry-corner-radius 0 // Set every window radius to 20
        clip-to-geometry true
    }

    window-rule {
        match app-id="mpv"
        default-column-width {}
    }

    layer-rule {
        match namespace="^noctalia-wallpaper*"
        place-within-backdrop true
    }

    window-rule {
        match app-id="gamescope"
        open-fullscreen true
    }

    window-rule {
        match app-id="steam_app_3321460"
        open-fullscreen true
    }

    window-rule {
      match title="(?i)picture.in.picture"
      default-column-width { proportion 0.25; }
      open-floating true
      default-floating-position x=100 y=200 relative-to="bottom-right"
    }

    window-rule {
        match app-id="thorium-nngceckbapebfimnlniiiahkandclblb-Default"
        open-floating true
        default-column-width { proportion 0.25; }
    }

    // window-rule {
    //     match app-id="steam" title=r#"^notificationtoasts_\d+_desktop$"#
    //     default-floating-position x=10 y=10 relative-to="bottom-right"
    // }

    window-rule {
        match app-id="steam" title=r#"^notificationtoasts_\d+_desktop$"#
        default-floating-position x=10 y=10 relative-to="bottom-right"
    }


    window-rule {
        match app-id="thorium-browser"
        default-column-width { proportion 1.0; }
    }

