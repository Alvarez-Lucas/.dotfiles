    layout {
        gaps 0 // Gap between windows
        // center-focused-column "never" // Don’t auto-center focused column
        // center-focused-column "always" // Don’t auto-center focused column

        background-color "transparent" // <- needed for noctalia-shell to set wallpaper
        always-center-single-column

        preset-column-widths {
            proportion 0.33333
            proportion 0.5
            proportion 0.66667
        }

        tab-indicator {
            width 16
            gap 0
            length total-proportion=1.0
            place-within-column
        }

        struts {}
    }


